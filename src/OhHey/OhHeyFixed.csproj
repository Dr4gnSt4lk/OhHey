<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>0.0.6</Version>
    <Authors>Mei, BnuuyAster</Authors>
    <Description>Ever wanted to get notified when someone targets you or emotes at you? Now you can!</Description>
    <PackageProjectUrl>https://github.com/Dr4gnSt4lk/OhHey</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <DalamudApiLevel>15</DalamudApiLevel>
	<DalamudPackage>true</DalamudPackage>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>true</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="images\icon.png" />
    <Content Include="OhHeyFixed.yaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
  </ItemGroup>

</Project>
